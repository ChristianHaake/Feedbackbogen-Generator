{
  "name": "feedbackbogen-generator",
  "version": "2.1.0",
  "description": "Webbasiertes Werkzeug zur Erstellung strukturierter Feedback- und Bewertungsbögen für Unterricht, Fortbildungen und weitere Lernkontexte.",
  "author": "Christian Haake",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --open",
    "prebuild": "npm run check:content",
    "build": "vite build",
    "check:content": "node scripts/validate-content.mjs",
    "verify:live": "node scripts/verify-live-deploy.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint src tests vite.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run check:content && npm run check:i18n && npm run lint && npm run typecheck && npm test -- --run && npm run build",
    "check:i18n": "node scripts/validate-i18n.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^8.5.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "write-excel-file": "^4.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vitest/coverage-v8": "^5.1.0",
    "deepmerge": "file:vendor/deepmerge",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "sharp": "^0.35.1",
    "typescript": "^5.6.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "deepmerge": "file:vendor/deepmerge",
    "esbuild": "0.28.1",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5",
    "glob@>=9.0.0 <=14.0.1": "^14.0.4",
    "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7"
  },
  "engines": {
    "node": "26.x"
  }
}
